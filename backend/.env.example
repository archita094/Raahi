# =============================================================================
# Raahi Backend Environment Configuration
# =============================================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration (MongoDB)
# -----------------------------------------------------------------------------
# Local MongoDB Community Server:
MONGODB_URI=mongodb://127.0.0.1:27017/raahi
# OR MongoDB Atlas Free Cloud Tier:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/raahi?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# AI & LLM Services (Google Gemini / LangChain / LangGraph)
# -----------------------------------------------------------------------------
# Get a free Gemini API Key at: https://aistudio.google.com/app/apikey
# Powers the autonomous LangGraph Transit Agent and RAG itinerary explanations.
# If omitted or invalid, system gracefully falls back to deterministic rule-based solver.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere1234567890

# -----------------------------------------------------------------------------
# Security & Authentication Secrets
# -----------------------------------------------------------------------------
# Secret API key required to access administrative PDF import routes (POST /api/admin/import-pdf)
ADMIN_API_KEY=raahi_ctu_admin_secret_key_2026

# Secret key used for signing JWT passenger authentication tokens
JWT_SECRET=raahi_jwt_secret_key_chandigarh_bus

# -----------------------------------------------------------------------------
# External Transit & Traffic Providers (Optional)
# -----------------------------------------------------------------------------
# Optional live traffic provider API key (e.g., Google Distance Matrix / TomTom).
# If omitted, strictly uses CTU official timetable schedules without fabricating delay.
LIVE_TRAFFIC_API_KEY=
